{
  "$schema": "../../packages/scenario-schema/scenario.schema.json",
  "id": "duplicate-payment",
  "title": "What happens when Pay is clicked twice?",
  "level": "senior",
  "invariant": "One payment intent creates at most one external charge.",
  "failureInjection": [
    "concurrency-barrier",
    "provider-latency"
  ],
  "modes": [
    {
      "id": "unprotected",
      "label": "Unprotected",
      "mechanisms": [],
      "expectedEffects": {
        "chargeAttempts": 2,
        "successfulPayments": 2
      }
    },
    {
      "id": "database-constraint",
      "label": "Database constraint",
      "mechanisms": [
        "unique-business-key"
      ],
      "expectedEffects": {
        "chargeAttempts": 1,
        "successfulPayments": 1
      }
    },
    {
      "id": "idempotent-api",
      "label": "Idempotent API",
      "mechanisms": [
        "idempotency-key",
        "request-fingerprint",
        "response-replay"
      ],
      "expectedEffects": {
        "chargeAttempts": 1,
        "successfulPayments": 1
      }
    }
  ],
  "visualization": {
    "lanes": [
      "client-a",
      "client-b",
      "api",
      "database",
      "payment-provider"
    ],
    "outputs": [
      "interactive-web",
      "remotion-video"
    ]
  }
}
