{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/emremenekse/backend-systems-visual-lab/main/packages/scenario-schema/scenario.schema.json",
  "title": "Backend Systems Visual Lab scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "level",
    "invariant",
    "failureInjection",
    "modes",
    "visualization"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "senior",
        "staff",
        "principal"
      ]
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "failureInjection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/mode"
      }
    },
    "visualization": {
      "$ref": "#/$defs/visualization"
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "mechanisms",
        "expectedEffects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "mechanisms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "expectedEffects": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lanes",
        "outputs"
      ],
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "interactive-web",
              "remotion-video"
            ]
          }
        }
      }
    }
  }
}
